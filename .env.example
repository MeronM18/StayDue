# Copy to .env.local. Use LOCAL values from `supabase status` for development.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
APP_ORIGIN=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Per million tokens; verify model pricing before changing model.
OPENAI_INPUT_COST_PER_MILLION=0.40
OPENAI_OUTPUT_COST_PER_MILLION=1.60
SENTRY_DSN=
# Supabase CLI reads root .env, not Next's .env.local. See docs/SETUP.md.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
